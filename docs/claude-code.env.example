# Claude Code -> CLIProxyAPI
# Put these into Claude Code settings (env)

ANTHROPIC_BASE_URL=http://127.0.0.1:8317
# This must match one of config.yaml: api-keys
ANTHROPIC_API_KEY=sk-your-client-api-key

# IMPORTANT: do NOT use fast/code/brain unless you configured Codex OAuth/API keys.
# Replace the models below with models that exist in your `config.yaml`.
ANTHROPIC_DEFAULT_HAIKU_MODEL=your-haiku-model
ANTHROPIC_DEFAULT_SONNET_MODEL=your-sonnet-model
ANTHROPIC_DEFAULT_OPUS_MODEL=your-opus-model

# Optional: reduce background calls
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
